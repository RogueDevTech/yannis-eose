# ============================================================
# Yannis EOSE — API environment (apps/api)
# Copy to `.env` and fill in. The app boots and runs safely with any of the
# OPTIONAL groups below unset — features that need them simply report
# "not configured" and are skipped, never erroring the app.
# ============================================================

# ── Core (required) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/yannis?sslmode=require
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-a-long-random-string
PORT=4444
NODE_ENV=development

# ── Edge form / intake (Pillar 1 — revenue) ─────────────────
EDGE_API_KEY=
EDGE_WORKER_URL=

# ── Email: SendGrid (Marketing Automation EMAIL channel + notifications) ──
# Without SENDGRID_API_KEY, email sends are skipped (in-app notifications still work).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yannis.com
SENDGRID_FROM_NAME=Yannis EOSE

# ── Web push (PWA notifications) ────────────────────────────
# Generate once: npx web-push generate-vapid-keys — share the public key with the web app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yannis.com

# ── SMS: Africa's Talking (Marketing Automation SMS channel) ──
# Reuses the same account as VOIP. Without AT_USERNAME + AT_API_KEY the SMS
# channel reports "not configured" and the engine skips SMS sends.
AT_USERNAME=
AT_API_KEY=
# Optional: approved alphanumeric sender id / short code. Omit to use AT's default.
AT_SMS_SENDER_ID=
# (AT_PHONE_NUMBER / AT_API_BASE below are for VOIP voice, a different endpoint.)

# ── WhatsApp: Termii (Marketing Automation WHATSAPP channel) ──
# Without TERMII_API_KEY + TERMII_WHATSAPP_SENDER_ID the WhatsApp channel
# reports "not configured" and the engine skips WhatsApp sends.
TERMII_API_KEY=
TERMII_WHATSAPP_SENDER_ID=
# Optional host override (defaults to https://api.ng.termii.com).
TERMII_BASE_URL=

# ── VOIP: Africa's Talking / Twilio (voice calls — optional) ─
AT_PHONE_NUMBER=
AT_API_BASE=
VOIP_WEBHOOK_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_TWIML_APP_SID=

# ── Payments: Paystack ──────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_API_URL=
PAYSTACK_CALLBACK_BASE_URL=

# ── Object storage ──────────────────────────────────────────
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_BASE_URL=
GCP_PROJECT_ID=

# ── Misc / tuning (optional) ────────────────────────────────
API_URL=
APP_URL=
CORS_ORIGIN=
PG_MAX_CONNECTIONS=30
READ_THROUGH_CACHE_ENABLED=true
SESSION_TTL_SECONDS=
ENABLE_AI_ASSISTANT=
